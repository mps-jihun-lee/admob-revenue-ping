{
  "name": "admob-revenue-ping",
  "version": "0.1.0",
  "private": true,
  "description": "Send yesterday's AdMob estimated earnings to Discord",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "auth": "node --env-file-if-exists=.env --import tsx src/cli.ts auth",
    "once": "node --env-file-if-exists=.env --import tsx src/cli.ts once",
    "demo": "node --import tsx src/cli.ts demo",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "google-auth-library": "^10.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
