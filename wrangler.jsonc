// AdMob 전날 수익 Discord 알림. 매일 한 번 ACCOUNTS의 계정(여비·반다라트)을 차례로 처리한다. 운영 방법은 docs/CLOUDFLARE_WORKER.md
// 비밀값: ACCOUNTS(JSON, 게시자 ID 포함), OAUTH_CLIENT_ID, OAUTH_CLIENT_SECRET, 계정별 refresh token·Discord 웹훅(이름은 ACCOUNTS에 적음)
// 무료 플랜 Cron Trigger는 계정당 5개다. 이 Worker는 1개를 쓴다.
{
  "name": "admob-revenue-ping",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  // 00:10 UTC = 09:10 KST(로컬 launchd와 같은 시각). 01:10·02:10은 재시도다. 표현식 하나라 트리거 1개로 센다.
  // 이미 보낸 날짜(D1 행)는 건너뛰므로 재시도가 중복을 만들지 않는다. 토큰·AdMob 실패나 Discord 4xx일 때만 다시 보낸다.
  // 모든 계정의 보고 시간대에서 재시도 시각이 같은 날이어야 한다(Asia/Seoul 기준 09:10~11:10).
  "triggers": { "crons": ["10 0-2 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "admob-revenue-ping",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
